<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- NuGet package metadata -->
    <PackageId>QuickJsWasi</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Porsa Platform</Authors>
    <Description>Snapshotable JavaScript runtime for .NET via WebAssembly. QuickJS-NG compiled to a WASI reactor with snapshot/restore support, ES module loading, host functions, and a clean C# API.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Porsa-Platform/quickjs-wasi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Porsa-Platform/quickjs-wasi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>quickjs;javascript;js;wasm;webassembly;sandbox;scripting;runtime</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Wasmtime" Version="44.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embed the WASM binary when present so consumers need no extra file -->
    <EmbeddedResource Include="Resources/quickjs.wasm" Condition="Exists('Resources/quickjs.wasm')" />
    <!-- Include the README in the NuGet package for nuget.org display -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
